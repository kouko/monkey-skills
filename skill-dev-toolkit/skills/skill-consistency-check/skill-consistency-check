#!/usr/bin/env python3
"""
Main entry point for skill-consistency-check skill.

Orchestrates the full consistency checking pipeline:
1. Extract rules and structure from skill files
2. Build dependency graph
3. Apply static rule checks (Layer 1)
4. Apply SMT formal verification (Layer 2)
5. Apply LLM cross-verification (Layer 3)
6. Generate report

Exit codes:
  0 = PASS (no Critical/High issues)
  1 = NEEDS_REVISION (has Critical/High issues)
  2 = ERROR (execution failed, invalid path, missing scripts)
"""

import argparse
import json
import subprocess
import sys
from pathlib import Path
from typing import Any, Dict, List, Optional


def run_command(cmd: List[str], input_data: str = None) -> tuple[int, str, str]:
    """Run a command and return (exit_code, stdout, stderr)."""
    try:
        proc = subprocess.Popen(
            cmd,
            stdin=subprocess.PIPE if input_data else None,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )
        stdout, stderr = proc.communicate(input=input_data, timeout=30)
        return proc.returncode, stdout.strip(), stderr.strip()
    except subprocess.TimeoutExpired:
        proc.kill()
        return -1, "", "Command timed out"
    except Exception as e:
        return -1, "", f"Error running command: {e}"


def extract_skill(skill_path: Path) -> Dict[str, Any]:
    """Run extraction script."""
    script = skill_path.parent / "skills" / "skill-consistency-check" / "scripts" / "extract_rules.py"
    if not script.exists():
        # Try alternative location
        script = Path(__file__).parent / "scripts" / "extract_rules.py"

    if not script.exists():
        print(f"Extraction script not found at {script}", file=sys.stderr)
        return {}

    code, stdout, stderr = run_command([sys.executable, str(script), str(skill_path)])
    if code != 0:
        print(f"Extraction failed: {stderr}", file=sys.stderr)
        return {}
    try:
        return json.loads(stdout)
    except json.JSONDecodeError:
        return {}


def build_graph(extracted_data: Dict[str, Any], skill_path: Path) -> Dict[str, Any]:
    """Run graph building script."""
    script = Path(__file__).parent / "scripts" / "build_dependency_graph.py"

    if not script.exists():
        print(f"Graph building script not found at {script}", file=sys.stderr)
        return {"nodes": {}, "edges": []}

    # Write extracted data to temp file
    import tempfile
    with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False) as f:
        json.dump(extracted_data, f)
        temp_file = f.name

    try:
        code, stdout, stderr = run_command([sys.executable, str(script), temp_file])
        if code != 0:
            print(f"Graph building failed: {stderr}", file=sys.stderr)
            return {"nodes": {}, "edges": []}
        return json.loads(stdout)
    finally:
        Path(temp_file).unlink()


def check_mechanical(skill_path: Path, extracted_data: Dict[str, Any]) -> List[Dict[str, Any]]:
    """Run mechanical consistency checks."""
    script = Path(__file__).parent / "scripts" / "check_consistency.py"
    if not script.exists():
        return []

    # Write extracted data to temp file
    import tempfile
    with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False) as f:
        json.dump(extracted_data, f)
        temp_file = f.name

    try:
        code, stdout, stderr = run_command([sys.executable, str(script), str(skill_path), temp_file])
        if code != 0:
            print(f"Mechanical check failed: {stderr}", file=sys.stderr)
            return []
        return json.loads(stdout)
    finally:
        Path(temp_file).unlink()


def check_smt(extracted_data: Dict[str, Any], skill_path: Path) -> Dict[str, Any]:
    """Run SMT verification."""
    script = Path(__file__).parent / "scripts" / "smt_encode.py"
    if not script.exists():
        return {"z3_available": False, "message": "Z3 not available"}

    # Write extracted data to temp file
    import tempfile
    with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False) as f:
        json.dump(extracted_data, f)
        temp_file = f.name

    try:
        code, stdout, stderr = run_command([sys.executable, str(script), temp_file])
        if code != 0:
            print(f"SMT check failed: {stderr}", file=sys.stderr)
            return {"z3_available": False, "message": "SMT check failed"}
        return json.loads(stdout)
    finally:
        Path(temp_file).unlink()


