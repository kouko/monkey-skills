def check_patterns(extracted_data: Dict[str, Any], graph_data: Dict[str, Any],
                   skill_path: Path) -> List[Dict[str, Any]]:
    """Run static pattern matching checks (Layer 1)."""
    script = Path(__file__).parent / "scripts" / "pattern_engine.py"
    if not script.exists():
        return []

    # Write extracted data to temp file
    import tempfile
    with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False) as f_extract:
        json.dump(extracted_data, f_extract)
        extract_file = f_extract.name

    with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False) as f_graph:
        json.dump(graph_data, f_graph)
        graph_file = f_graph.name

    try:
        code, stdout, stderr = run_command([
            sys.executable, str(script), str(skill_path), extract_file, graph_file
        ])

        if code != 0:
            print(f"Pattern check failed (code={code}): {stderr}", file=sys.stderr)
            return []

        if not stdout.strip():
            return []

        return json.loads(stdout)
    except json.JSONDecodeError:
        return []
    finally:
        # Clean up temp files
        for f in [extract_file, graph_file]:
            try:
                Path(f).unlink()
            except:
                pass


def generate_report(issues: List[Dict[str, Any]], skill_path: Path,
                   extracted_data: Dict[str, Any], graph_data: Dict[str, Any],
                   smt_result: Dict[str, Any]) -> Dict[str, Any]:
    """Run report generation."""
    script = Path(__file__).parent / "scripts" / "generate_report.py"
    if not script.exists():
        # Simple fallback
        return {
            "summary": {
                "skill_path": str(skill_path),
                "total_issues": len(issues),
                "severity_counts": {},
                "files_checked": len(extracted_data.get("files", [])),
                "rules_found": len(extracted_data.get("rules", [])),
                "sections_found": len(extracted_data.get("sections", []))
            },
            "issues": issues
        }

    # Write all data to temp files
    import tempfile
    with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False) as f_extract:
        json.dump(extracted_data, f_extract)
        extract_file = f_extract.name

    with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False) as f_graph:
        json.dump(graph_data, f_graph)
        graph_file = f_graph.name

    with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False) as f_smt:
        json.dump(smt_result, f_smt)
        smt_file = f_smt.name

    try:
        # Write issues to temp file
        with tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False) as f_issues:
            json.dump(issues, f_issues)
            issues_file = f_issues.name

        code, stdout, stderr = run_command([
            sys.executable, str(script), issues_file, str(skill_path),
            extract_file, graph_file, smt_file
        ])

        if code != 0:
            print(f"Report generation failed: {stderr}", file=sys.stderr)
            return {
                "summary": {
                    "skill_path": str(skill_path),
                    "total_issues": len(issues),
                    "severity_counts": {},
                    "files_checked": len(extracted_data.get("files", [])),
                    "rules_found": len(extracted_data.get("rules", [])),
                    "sections_found": len(extracted_data.get("sections", []))
                },
                "issues": issues
            }

        # Read the generated files
        report_file = skill_path / "consistency-report.jsonl"
        if report_file.exists():
            # Parse JSONL to reconstruct report
            summary_data = None
            issue_data = []
            with open(report_file, 'r') as f:
                for line in f:
                    line = line.strip()
                    if line:
                        try:
                            data = json.loads(line)
                            if data.get("type") == "summary":
                                summary_data = data.get("data")
                            elif data.get("type") == "issue":
                                issue_data.append(data.get("data"))
                        except json.JSONDecodeError:
                            pass

            if summary_data is not None:
                return {
                    "summary": summary_data,
                    "issues": issue_data
                }

        # Fallback
        return {
            "summary": {
                "skill_path": str(skill_path),
                "total_issues": len(issues),
                "severity_counts": {},
                "files_checked": len(extracted_data.get("files", [])),
                "rules_found": len(extracted_data.get("rules", [])),
                "sections_found": len(extracted_data.get("sections", []))
            },
            "issues": issues
        }
    finally:
        # Clean up temp files
        for f in [extract_file, graph_file, smt_file, issues_file]:
            try:
                Path(f).unlink()
            except:
                pass


def parse_args(argv: Optional[List[str]] = None) -> argparse.Namespace:
    """Parse command-line arguments."""
    parser = argparse.ArgumentParser(
        prog="skill-consistency-check",
        description="Check logical contradictions and inconsistencies in skill files.",
    )
    parser.add_argument(
        "skill_directory",
        type=str,
        help="Path to the skill directory to check.",
    )
    parser.add_argument(
        "--format",
        type=str,
        choices=["json", "jsonl"],
        default="json",
        help="Output format: 'json' (default, pretty-printed) or 'jsonl' (one issue per line).",
    )
    parser.add_argument(
        "--skip-layer",
        type=str,
        action="append",
        default=[],
        choices=["pattern", "smt", "llm"],
        help="Skip a pipeline layer (can be repeated). Use --skip-layer=llm to skip the LLM placeholder.",
    )
    parser.add_argument(
        "--quiet",
        action="store_true",
        default=False,
        help="Quiet mode: output only the final report to stdout, suppress stderr progress.",
    )
    parser.add_argument(
        "--no-llm",
        action="store_true",
        default=False,
        help="Skip LLM cross-verification (placeholder layer).",
    )
    parser.add_argument(
        "--verbose",
        action="store_true",
        default=False,
        help="Show detailed per-layer progress on stderr.",
    )
    return parser.parse_args(argv)


def main():
    args = parse_args()

    skill_path = Path(args.skill_directory)
    if not skill_path.exists():
        print(f"Error: Path {skill_path} does not exist", file=sys.stderr)
        sys.exit(2)

    # Determine verbosity
    quiet = args.quiet
    verbose = args.verbose and not quiet  # verbose only meaningful if not quiet

    if not quiet:
        print(f"Checking consistency of skill at: {skill_path}", file=sys.stderr)

    # Step 1: Extract rules and structure
    if not quiet:
        print("Step 1: Extracting rules and structure...", file=sys.stderr)

    extracted_data = extract_skill(skill_path)
    if not extracted_data:
        if not quiet:
            print("Warning: No data extracted", file=sys.stderr)
        extracted_data = {"files": [], "rules": [], "sections": [], "code_blocks": [], "references": []}

    # Step 2: Build dependency graph
    if not quiet:
        print("Step 2: Building dependency graph...", file=sys.stderr)

    graph_data = build_graph(extracted_data, skill_path)

    # Layer filtering
    skip_layers = set(args.skip_layer) if args.skip_layer else set()
    skip_pattern = "pattern" in skip_layers
    skip_smt = "smt" in skip_layers
    skip_llm = "llm" in skip_layers or args.no_llm

    # Step 3: Mechanical checks
    if not quiet:
        print("Step 3: Running mechanical consistency checks...", file=sys.stderr)
    mechanical_issues = check_mechanical(skill_path, extracted_data)

    # Step 4: Static rule checks (from conflict patterns)
    if not skip_pattern:
        if not quiet:
            print("Step 4: Applying static rule checks (pattern matching)...", file=sys.stderr)
        static_issues = check_patterns(extracted_data, graph_data, skill_path)
    else:
        if not quiet:
            print("Step 4: Skipping pattern layer (--skip-layer=pattern)", file=sys.stderr)
        static_issues = []

    # Step 5: SMT verification
    if not skip_smt:
        if not quiet:
            print("Step 5: Running SMT formal verification...", file=sys.stderr)
        smt_result = check_smt(extracted_data, skill_path)
    else:
        if not quiet:
            print("Step 5: Skipping SMT layer (--skip-layer=smt)", file=sys.stderr)
        smt_result = {"z3_available": False, "message": "SMT layer skipped"}

    # Step 6: LLM cross-verification (placeholder)
    if not skip_llm:
        if not quiet:
            print("Step 6: Running LLM cross-verification...", file=sys.stderr)
        llm_issues = check_llm(extracted_data, graph_data, smt_result, skill_path)
    else:
        if not quiet:
            print("Step 6: Skipping LLM layer (--skip-layer=llm)", file=sys.stderr)
        llm_issues = []

    # Combine all issues
    all_issues = mechanical_issues + static_issues + llm_issues

    # Step 7: Generate report
    if not quiet:
        print("Step 7: Generating report...", file=sys.stderr)
    report = generate_report(all_issues, skill_path, extracted_data, graph_data, smt_result)

    # Determine exit code based on issue severity
    has_critical_or_high = any(
        issue.get("severity") in ("Critical", "High") for issue in all_issues
    )

    # Output report
    if args.format == "jsonl":
        # Output as JSONL: one JSON object per line
        if isinstance(report, dict) and "issues" in report:
            for issue in report["issues"]:
                print(json.dumps(issue, ensure_ascii=False))
        elif isinstance(report, list):
            for issue in report:
                print(json.dumps(issue, ensure_ascii=False))
    else:
        # Default JSON output
        if not quiet:
            print(json.dumps(report, indent=2, ensure_ascii=False))
        else:
            # Just output the summary
            summary = report.get("summary", {})
            print(json.dumps(summary, indent=2, ensure_ascii=False))

    # Exit code
    if has_critical_or_high:
        sys.exit(1)  # NEEDS_REVISION
    else:
        sys.exit(0)  # PASS


if __name__ == '__main__':
    main()
