#!/usr/bin/env bash
# SessionStart hook for loom-code (concept-model §4, §7a; plan W0-05 / REQ-8).
#
# What it injects, and nothing else:
#   1. one line naming the station order,
#   2. the three human decision points in plain words,
#   3. a pointer to the entry station's SKILL.md for the full summary table,
#   4. the repo's KICKOFF-DEFAULTS lines when that file exists.
#
# Station names and decision-point owners are DERIVED at runtime from
# loom-code/contract/manifest.yaml — the contract package is the single
# source; this script must never carry a second hand-typed copy.
#
# Budget: `bash loom-code/hooks/session-start </dev/null | wc -w` with cwd =
# an empty git repo must stay <= 2640 words (half of the 923fb84a baseline
# of 5281). Guarded by scripts/test_session_start_words.py.
#
# CANONICAL key (both hosts consume): hookSpecificOutput.additionalContext.
# DEFENSIVE keys (`additional_context`, bare `additionalContext`) are emitted
# too, for cross-version/host shape drift; a host that does not read them
# ignores them.
#
# Escape hatch: export LOOM_CODE_MODE=off  # no-op JSON, no injection.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
MANIFEST="${SCRIPT_DIR}/../contract/manifest.yaml"

emit_empty() {
  printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":""},"additional_context":"","additionalContext":""}\n'
}

if [ "${LOOM_CODE_MODE:-on}" = "off" ]; then
  emit_empty
  exit 0
fi

# Manifest missing → fail open (never crash the session).
if [ ! -f "${MANIFEST}" ]; then
  emit_empty
  exit 0
fi

# --- derived from the contract package ------------------------------------
# One `- {name: <station>, ...}` line per station, in manifest order.
stations_block() {
  awk '/^stations:/{f=1;next} /^[a-z_]+:/{f=0} f' "${MANIFEST}"
}

station_names="$(stations_block | sed -n 's/^[[:space:]]*-[[:space:]]*{name:[[:space:]]*\([a-z0-9-]*\).*/\1/p')"

# Stations owning a given decision point, joined by " / ".
stations_for_dp() {
  stations_block \
    | grep "decision_point: $1" \
    | sed -n 's/^[[:space:]]*-[[:space:]]*{name:[[:space:]]*\([a-z0-9-]*\).*/\1/p' \
    | paste -sd@ - | sed 's/@/ \/ /g'
}

flow=""
tail_station=""
for name in ${station_names}; do
  if [ "${name}" = "maintain" ]; then
    tail_station="${name}"
    continue
  fi
  if [ -z "${flow}" ]; then flow="${name}"; else flow="${flow} → ${name}"; fi
done

dp1="$(stations_for_dp 1)"
dp2="$(stations_for_dp 2)"
dp3="$(stations_for_dp 3)"

entry_station="${dp1%% *}"

# --- the injected body ----------------------------------------------------
body="You have loom-code. Work on this repo runs through stations, one artifact each.

Station order: ${flow}; ${tail_station} on alerts.

You ask the user exactly three times. Everything else you decide yourself and record the reason as agent-decided:
① after the intent is written (${dp1}) — restate the problem and the acceptance conditions in plain words and get \"yes, this is what I want\"; fold any one-way-door choice, the once-per-change second-vendor suggestion and a missing-principles interview into this same conversation.
② only for a product change, after the spec is written (${dp2}) — read back the visible behaviour (\"you type X, you see Y\") and get \"yes\"; never show design rationale.
③ at the end (${dp3}) — the user reads the blind-run report, one line per acceptance condition, and accepts. They never review a diff.

Never ask the user to judge spec quality, plan shape, or a review verdict — they cannot, and the machines are the reviewers.

The full station summary table (what each station reads, produces, and when the checker and the checkpoints fire) lives in the entry station's SKILL.md: ${entry_station}, or write-plan when loom-design is not installed. Load it there; it is not repeated here."

# --- repo defaults --------------------------------------------------------
DEFAULTS_FILE="docs/loom/KICKOFF-DEFAULTS.md"
if [ -f "${DEFAULTS_FILE}" ]; then
  defaults="$(sed -n 's/^-[[:space:]]\{1,\}\(.*: .*\)$/- \1/p' "${DEFAULTS_FILE}")"
  if [ -n "${defaults}" ]; then
    body="${body}

This repo's standing defaults (docs/loom/KICKOFF-DEFAULTS.md):
${defaults}"
  fi
fi

# JSON-escape via bash parameter substitution.
escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}
context="$(escape_for_json "${body}")"

printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"},"additional_context":"%s","additionalContext":"%s"}\n' \
  "${context}" "${context}" "${context}"
