#!/usr/bin/env bash
# SessionStart hook for loom-code.
# Reads hooks/router-card.md (slim pre-invocation card: coding mandate +
# five load-bearing rules + SUBAGENT-STOP) AND hooks/family-reception.md
# (loom family front door: family map + three doors + on-ramp criteria) and
# injects both as additionalContext. The full using-loom-code SKILL.md body
# is NOT injected — the Skill tool loads it on invocation (pull, not push).
# Rationale + firing gate: docs/loom/plans/2026-07-06-loom-code-router-card-slim.md.
# DRIFT NOTE: router-card.md's five rules are a hand-maintained tightened
# copy of skills/using-loom-code/SKILL.md's — edit BOTH on any rule change
# (rule-level sync is guarded by scripts/test_router_card_rule_tokens.py,
# which asserts each rule's anchor token in both files; card wording stays
# deliberately compressed, not byte-identical).
#
# CANONICAL key (both hosts consume): hookSpecificOutput.additionalContext
# Per the official Codex hooks contract (developers.openai.com/codex/hooks):
# "That additionalContext text is added as extra developer context." Claude
# Code reads the SAME nested camelCase key, so this one shape is what both
# hosts actually consume.
#
# DEFENSIVE keys (belt-and-suspenders, emitted for cross-version/host
# portability — NOT because Codex requires snake_case):
#   additional_context   (top-level snake_case)
#   additionalContext    (bare top-level camelCase)
# These are harmless extras a host ignores if it doesn't read them; we emit
# all three so the router survives host/version shape drift. This is a
# deliberate design — tests/integration/test-superpowers-mode-off.sh asserts
# all 3 keys are present (Check 4).
#
# Escape hatch (Phase 1.5):
#   export LOOM_CODE_MODE=off   # skip injection (no-op JSON returned)
#
# Reference: loom-code/TECH-SPEC.md §2.3
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CARD_PATH="${SCRIPT_DIR}/router-card.md"

# Escape hatch — Superpowers coexistence.
# Emit canonical nested key + both defensive top-level keys (all empty).
if [ "${LOOM_CODE_MODE:-on}" = "off" ]; then
  printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":""},"additional_context":"","additionalContext":""}\n'
  exit 0
fi

# Card file missing → fail open with empty context (do not crash the session).
# Same 3-key shape as the escape hatch.
if [ ! -f "${CARD_PATH}" ]; then
  printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":""},"additional_context":"","additionalContext":""}\n'
  exit 0
fi

content="$(cat "${CARD_PATH}")"

# JSON-escape via bash parameter substitution (mirror Superpowers).
escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}
escaped="$(escape_for_json "${content}")"

# Wrap in EXTREMELY-IMPORTANT block so the agent treats the router as load-bearing.
banner_open='<EXTREMELY_IMPORTANT>\nYou have loom-code. Routing through this skill is mandatory when applicable.\n\n'
banner_close='\n</EXTREMELY_IMPORTANT>'
context="${banner_open}${escaped}${banner_close}"

# Family reception (front door) — merged from loom-code/hooks/session-start.
# Reference: docs/loom/specs/2026-07-04-loom-family-connective-tissue.md
RECEPTION_PATH="${SCRIPT_DIR}/family-reception.md"
FAMILY_RELAY_PATH="${SCRIPT_DIR}/family-relay.md"

# Reception file missing → skip silently (router still injects; fail open).
if [ -f "${RECEPTION_PATH}" ]; then
  reception="$(cat "${RECEPTION_PATH}")"

  # Extract "### (b) Visual defaults" from family-relay.md AT RUNTIME
  # (heading-boundary awk range) and append it to the injected reception.
  # family-relay.md stays the SSOT — this script must never carry a copy of
  # the rule text. Fail open: missing file or missing section → skip
  # silently, reception still injects without it.
  if [ -f "${FAMILY_RELAY_PATH}" ]; then
    visual_defaults="$(awk '/^### \(b\) Visual defaults/{flag=1} /^### \(c\)/{flag=0} flag' "${FAMILY_RELAY_PATH}")"
    if [ -n "${visual_defaults}" ]; then
      reception="${reception}
${visual_defaults}"
    fi
  fi

  escaped_reception="$(escape_for_json "${reception}")"

  # Wrap in EXTREMELY-IMPORTANT block so the agent treats the reception as
  # load-bearing awareness (not a mandate — the reception recommends, it does
  # not gate).
  reception_banner_open='<EXTREMELY_IMPORTANT>\nYou have the loom family of plugins available. Read this reception before deciding where to route work.\n\n'
  reception_banner_close='\n</EXTREMELY_IMPORTANT>'
  context="${context}\n\n${reception_banner_open}${escaped_reception}${reception_banner_close}"
fi

# Emit canonical nested key + both defensive top-level keys (same content).
printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"},"additional_context":"%s","additionalContext":"%s"}\n' \
  "${context}" "${context}" "${context}"
