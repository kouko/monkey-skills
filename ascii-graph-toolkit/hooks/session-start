#!/usr/bin/env bash
# SessionStart hook for ascii-graph-toolkit.
# Reads hooks/trigger-card.md and injects it as additionalContext so every
# session carries the diagram trigger rule at the moment drawing actually
# happens (a reflexive act that never passes through skill routing on its
# own) — see docs/loom/specs/2026-07-10-ascii-graph-trigger-fix.md.
#
# CANONICAL key (both hosts consume): hookSpecificOutput.additionalContext
# hookEventName is REQUIRED inside hookSpecificOutput — omitting it
# silently disables the hook (see machine memory
# feedback_hook_specific_output_requires_hookeventname).
#
# ONLY top-level key: hookSpecificOutput. Codex CLI's session-start
# schema (codex-rs/hooks/src/schema.rs
# `SessionStartCommandOutputWire`) is `#[serde(deny_unknown_fields)]` —
# the allowed top-level keys are only `continue`, `stopReason`,
# `suppressOutput`, `systemMessage`, `hookSpecificOutput`. Any other
# top-level key (this script used to also emit `additional_context` and
# `additionalContext` defensively) makes Codex reject the WHOLE
# session-start output ("hook returned invalid session start JSON
# output"), so the card never loads there. Claude Code only ever reads
# hookSpecificOutput.additionalContext, so dropping the extra keys is
# safe on both hosts.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
CARD_PATH="${PLUGIN_ROOT}/hooks/trigger-card.md"

# Card file missing → fail open with empty context (do not crash the
# session). Same single-top-level-key shape as the populated case.
if [ ! -f "${CARD_PATH}" ]; then
  printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":""}}\n'
  exit 0
fi

content="$(cat "${CARD_PATH}")"

# JSON-escape via bash parameter substitution (mirror loom-pipeline).
escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}
escaped="$(escape_for_json "${content}")"

# Emit only the canonical nested key (see the top-level-key comment above).
printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' \
  "${escaped}"
